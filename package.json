{
    "name": "try-in-web-ide",
    "version": "1.0.0",
    "private": true,
    "description": "Try in Web IDE",
    "repository": {
        "type": "git",
        "url": "https://github.com/redhat-actions/try-in-web-ide"
    },
    "bugs": {
        "url": "https://github.com/redhat-actions/try-in-web-ide/issues"
    },
    "homepage": "https://github.com/redhat-actions/try-in-web-ide#readme",
    "author": "Red Hat",
    "license": "MIT",
    "scripts": {
        "compile": "tsc -p .",
        "bundle": "npx ncc build src/index.ts --source-map --minify",
        "clean": "rm -rf out/ dist/",
        "lint": "eslint . --max-warnings=0",
        "test": "jest"
    },
    "jest": {
        "collectCoverage": true,
        "collectCoverageFrom": [
            "src/**/*.ts"
        ],
        "coverageDirectory": "./coverage",
        "transform": {
            "^.+\\.[jt]sx?$": ["ts-jest", { "useESM": false }]
        },
        "transformIgnorePatterns": [
            "node_modules/(?!(inversify|@inversifyjs|@actions/github|@actions/core|@octokit)/)"
        ],
        "modulePathIgnorePatterns": [
            "<rootDir>/out"
        ],
        "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.(jsx?|tsx?)$",
        "moduleFileExtensions": [
            "ts",
            "tsx",
            "js",
            "jsx",
            "json"
        ]
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@redhat-actions/action-io-generator": "^1.5.0",
        "@types/fs-extra": "^11.0.4",
        "@types/jest": "^30.0.0",
        "@types/node": "^26",
        "@vercel/ncc": "^0.44.1",
        "eslint": "^10.8.1",
        "eslint-plugin-jest": "^29.16.1",
        "fs-extra": "^11.4.0",
        "jest": "^30.4.2",
        "ts-jest": "^29.4.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.67.0"
    },
    "overrides": {
        "brace-expansion": "^5.0.8"
    },
    "dependencies": {
        "@actions/core": "^3.0.1",
        "@actions/github": "^9.1.1",
        "@octokit/plugin-rest-endpoint-methods": "^18.0.0",
        "inversify": "^8.1.1",
        "reflect-metadata": "~0.2.2"
    }
}
